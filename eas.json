{
  "cli": {
    "appVersionSource": "local",
    "requireCommit": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": true
      },
      "env": {
        "API_URL": "https://thecaretrackerapp.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {},
      "env": {
        "API_URL": "https://thecaretrackerapp.com"
      }
    },
    "staging": {
      "autoIncrement": false,
      "channel": "staging",
      "android": {
        "gradleCommand": ":app:bundleRelease"
      },
      "ios": {
        "simulator": false,
        "scheme": "production",
        "buildConfiguration": "Release"
      },
      "env": {
        "NODE_ENV": "production",
        "API_URL": "https://thecaretrackerapp.net"
      }
    },
    "production": {
      "autoIncrement": false,
      "channel": "production",
      "android": {
        "gradleCommand": ":app:bundleRelease"
      },
      "ios": {
        "simulator": false,
        "scheme": "production",
        "buildConfiguration": "Release"
      },
      "env": {
        "NODE_ENV": "production",
        "API_URL": "https://thecaretrackerapp.net"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    }
  },
  "submit": {
    "staging": {
      "android": {
        "track": "internal",
        "applicationId": "com.caretracker.caretracker2"
      }
    },
    "production": {
      "android": {
        "track": "internal",
        "applicationId": "com.caretracker.caretracker2"
      }
    }
  }
}
