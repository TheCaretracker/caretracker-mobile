{
  "name": "caretracker",
  "version": "1.0.0",
  "scripts": {
    "dev": "ENVFILE=.env expo start  --",
    "start": "ENVFILE=.env expo start --dev-client --",
    "android": "ENVFILE=.env.local expo run:android --device",
    "ios": "expo run:ios --device",
    "web": "expo start --web",
    "build-preview": "eas build --profile preview",
    "build-staging": "eas build --profile staging",
    "build-prod": "eas build --profile production",
    "build-prod-local": "NODE_ENV=production script -q build-log.txt eas build --profile production --local --clear-cache",
    "build-staging-local": "NODE_ENV=production script -q build-log.txt eas build --profile staging --local --clear-cache",
    "submit-staging": "eas submit --profile staging",
    "submit-prod": "eas submit --profile production",
    "update-preview": "eas update --channel preview",
    "update-staging": "eas update --channel staging",
    "update-prod": "eas update --channel production",
    "build-submit-staging": "eas build --profile staging --auto-submit",
    "build-submit-prod": "eas build --profile production --auto-submit",
    "fix-code": "eslint ./src --fix",
    "clear-pod": "rm -rf ios/Pods ios/Podfile.lock ios/.xcode.env.local ios/build",
    "clear-gradle": "rm -rf ~/.gradle/caches android/.gradle android/build android/app/build && cd android && ./gradlew --stop && ./gradlew clean && cd ..",
    "prebuild-ios": "expo prebuild --platform ios --no-install",
    "prebuild-android": "expo prebuild --platform android --no-install",
    "postinstall": "patch-package",
    "apk-prod": "eas build --profile production-apk --platform android",
    "apk-prod-gradle": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 NODE_ENV=production __EXPO_CONFIG_MODE=production API_URL=https://thecaretrackerapp.net expo prebuild --platform android --clean && cd android && ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} NODE_ENV=production API_URL=https://thecaretrackerapp.net ./gradlew assembleRelease && open app/build/outputs/apk/release",
    "apk-prod-local":"NODE_ENV=production eas build --profile production-apk --platform android --local --clear-cache",
    "xcode-prod": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 __EXPO_CONFIG_MODE=production API_URL=https://thecaretrackerapp.net expo prebuild --platform ios --clean && open ios/CareTracker.xcworkspace"
  },
  "dependencies": {
    "@config-plugins/react-native-branch": "^13.0.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^27.1.1",
    "@react-native-firebase/app": "^27.1.1",
    "@react-native-firebase/messaging": "^27.1.1",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@sentry/react-native": "~8.28.0",
    "@twotalltotems/react-native-otp-input": "1.3.11",
    "@types/branch-sdk": "^2.53.7",
    "axios": "^1.21.1",
    "dayjs": "^1.11.23",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.21",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-iap": "^6.5.1",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "formik": "^2.4.9",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-branch": "7.0.0",
    "react-native-calendars": "^1.1314.0",
    "react-native-date-picker": "5.0.12",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-gifted-charts": "^1.4.83",
    "react-native-image-crop-picker": "^0.52.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.1",
    "socket.io-client": "^4.8.4",
    "styled-components": "^6.6.0",
    "toggle-switch-react-native": "^3.3.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/eslint-parser": "^7.29.13",
    "@babel/runtime": "^7.29.14",
    "@faker-js/faker": "^10.6.0",
    "@react-native-community/cli": "^21.0.0",
    "@react-native-community/cli-platform-ios": "^21.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@types/react-native-dotenv": "^0.2.0",
    "@types/react-test-renderer": "^19.3.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "install-peers": "^1.0.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.10.1",
    "react-native-dotenv": "^5.0.0",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "@react-native-community/clipboard": "npm:@react-native-clipboard/clipboard@^1.16.3"
  }
}
